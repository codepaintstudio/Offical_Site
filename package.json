{
  "name": "codepaint-resume",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:public": "bun run --filter @codepaint/public-web dev",
    "dev:admin": "bun run --filter @codepaint/admin-web dev",
    "dev": "bun run --filter \"@codepaint/*\" dev",
    "build": "bun run --filter \"@codepaint/*\" build",
    "typecheck": "bun run --filter \"@codepaint/*\" typecheck",
    "lint": "bun run --filter \"@codepaint/*\" lint"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
